# Paired RCU list policy profile; only the RCU implementation differs.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RUST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_SMP=y
# SeaBIOS exposes secondary CPUs through ACPI MADT in the pinned container.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_NR_CPUS=2
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK_LEGACY_AUTOLOAD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_RUSIX_BRD_RUST=y
CONFIG_KUNIT=y
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y
CONFIG_EXPERT=y
CONFIG_VMLINUX_MAP=y
CONFIG_RUSIX_COMPLETION_RUST=y
# Keep WARN/BUG behavior while disabling lock/list instrumentation explicitly.
CONFIG_BUG=y
# EXPERT selects this menu; individual instrumentation below stays disabled.
CONFIG_DEBUG_KERNEL=y
# CONFIG_LOCKDEP is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_PROVE_RAW_LOCK_NESTING is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_LIST_HARDENED is not set

CONFIG_RUSIX_RCU_LIST_TEST=y
CONFIG_TREE_RCU=y
CONFIG_TREE_SRCU=y
# CONFIG_MODULES is not set
# CONFIG_RCU_NOCB_CPU is not set
CONFIG_RUSIX_RCU_LIST_RUST=y

# Tree RCU batch differential fixtures.
CONFIG_RUSIX_RCU_BATCH_TEST=y
# CONFIG_RCU_BOOST is not set
# CONFIG_PREEMPT_RT is not set

# CONFIG_RUSIX_RCU_BATCH_RUST is not set
