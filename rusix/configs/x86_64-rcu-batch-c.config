# Paired RCU list policy profile; only the RCU implementation differs.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RUST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_SMP=y
# SeaBIOS exposes secondary CPUs through ACPI MADT in the pinned container.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_NR_CPUS=2
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK_LEGACY_AUTOLOAD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_RUSIX_BRD_RUST=y
CONFIG_KUNIT=y
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y
CONFIG_EXPERT=y
CONFIG_VMLINUX_MAP=y
CONFIG_RUSIX_COMPLETION_RUST=y
# Exercise assertions, lock/IRQ contracts and preserved list validation.
CONFIG_BUG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y
CONFIG_PROVE_RAW_LOCK_NESTING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_LIST_HARDENED=y

CONFIG_RUSIX_RCU_LIST_TEST=y
CONFIG_TREE_RCU=y
CONFIG_TREE_SRCU=y
# CONFIG_MODULES is not set
# CONFIG_RCU_NOCB_CPU is not set
CONFIG_RUSIX_RCU_LIST_RUST=y

# C-first Tree RCU batch fixtures; no Rust batch policy is selected.
CONFIG_RUSIX_RCU_BATCH_TEST=y
# CONFIG_RCU_BOOST is not set
# CONFIG_PREEMPT_RT is not set
