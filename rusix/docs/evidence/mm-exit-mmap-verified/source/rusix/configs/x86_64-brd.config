# VM-only C BRD contract baseline: 4 KiB pages, two CPUs, builtin RAM disk.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RUST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_SMP=y
# SeaBIOS exposes secondary CPUs through ACPI MADT in the pinned container.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_NR_CPUS=2
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK_LEGACY_AUTOLOAD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
