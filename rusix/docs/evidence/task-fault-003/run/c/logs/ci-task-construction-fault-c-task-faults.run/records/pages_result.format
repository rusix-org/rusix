name: pages_result
ID: 547
format:
	field:unsigned short common_type;	offset:0;	size:2;	signed:0;
	field:unsigned char common_flags;	offset:2;	size:1;	signed:0;
	field:unsigned char common_preempt_count;	offset:3;	size:1;	signed:0;
	field:int common_pid;	offset:4;	size:4;	signed:1;

	field:unsigned long __probe_func;	offset:8;	size:8;	signed:0;
	field:unsigned long __probe_ret_ip;	offset:16;	size:8;	signed:0;
	field:u32 order;	offset:24;	size:4;	signed:0;
	field:u64 result;	offset:28;	size:8;	signed:0;

print fmt: "(%lx <- %lx) order=%u result=0x%Lx", REC->__probe_func, REC->__probe_ret_ip, REC->order, REC->result
