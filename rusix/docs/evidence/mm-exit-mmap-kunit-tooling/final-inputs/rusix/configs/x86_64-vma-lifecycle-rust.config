# VMA lifecycle consumer profile derived from x86_64-server.config.
# Allnoconfig input; no KUnit or construction fixture selected.
# Linux 6.18.58 declared target; server-c derives only a C-core comparison.
# Built-in ELF64 userspace, default Linux DAC/capabilities, no optional LSM policy.
CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_RUST=y
CONFIG_RUSIX_COMPLETION_RUST=y
CONFIG_VMLINUX_MAP=y
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_SYSCTL=y
# LTS selects the internal SYSCTL symbol through the /proc/sys interface.
CONFIG_PROC_SYSCTL=y
CONFIG_BUG=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_RSEQ=y
CONFIG_FHANDLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK_LEGACY_AUTOLOAD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_RUSIX_BRD_RUST=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
# Seccomp uses classic BPF; BPF_SYSCALL below excludes userspace eBPF.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
# Deliberate target exclusions; allnoconfig excludes unrequested drivers/features.
# CONFIG_MODULES is not set
# CONFIG_KUNIT is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set

# QEMU q35: ACPI enumeration, PCI virtio, 8250 serial; x86_64 pages are 4 KiB.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_VIRTIO_PCI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_VIRTIO_MMIO is not set

# Preserve enabled-by-default x86 vulnerability mitigations under allnoconfig.
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y

# Constructor transaction comparison scope; same consumers and debug settings.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_LIST=y
# CONFIG_PREEMPT_RT is not set
# CONFIG_VMAP_STACK is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_KASAN is not set
# CONFIG_KMSAN is not set
# CONFIG_KCSAN is not set
# CONFIG_MEM_ALLOC_PROFILING is not set
CONFIG_RUSIX_TASK_CONSTRUCTION_RUST=y

# MM constructor scope; retains PER_VMA_LOCK/private futex/hotplug/PTI.
# CONFIG_MEMCG is not set
# CONFIG_MM_ID is not set
# CONFIG_SCHED_MM_CID is not set
# CONFIG_LRU_GEN is not set
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_HUGETLB_PAGE is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_PARAVIRT is not set
CONFIG_RUSIX_MM_CONSTRUCTION_RUST=y

CONFIG_RUSIX_MM_RELEASE_RUST=y
CONFIG_RUSIX_MM_COPY_RUST=y

CONFIG_RUSIX_DUP_MMAP_RUST=y

CONFIG_RUSIX_VMA_LIFECYCLE_RUST=y
